{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Auto-bump pins so exact versions never rot: GitHub Actions (@v1 pins incl. semver-calver-release), the Gatus docker image pinned inside scripts/010-provision.sh, and the OpenTofu version pinned in .opentofu-version (both via regex custom managers).",
  "enabledManagers": ["github-actions", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Gatus docker image pinned in the provisioning script",
      "managerFilePatterns": ["/^scripts/010-provision\\.sh$/"],
      "matchStrings": [
        "\\s*# renovate: depName=(?<depName>\\S+) datasource=(?<datasource>\\S+)\\s*\\n\\s*[A-Z_]+=\"${depName}:(?<currentValue>[^\\s\"]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "OpenTofu CLI version pinned in .opentofu-version",
      "managerFilePatterns": ["/^\\.opentofu-version$/"],
      "matchStrings": [
        "^(?<currentValue>\\d+\\.\\d+\\.\\d+)$"
      ],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    }
  ]
}
